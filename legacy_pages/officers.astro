---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import SubpageHeader from '../components/sections/SubpageHeader.astro';
import CrossPageBanner from '../components/sections/CrossPageBanner.astro';
import Footer from '../components/navigation/Footer.astro';

const institutionalSupervisors = [
  {
    name: 'Dr. Anna Maria V. Rivera',
    position: 'Dean, College of Arts & Sciences',
    description: 'Institutional patron ensuring academic rigor, university accreditation standards, and collegiate excellence.',
    dossier: "Dean's Office • BatStateU The NEU",
    initials: 'AR',
  },
  {
    name: 'Dr. Jonelyn B. Sandoval',
    position: 'Faculty Adviser, CAS Honor Society',
    description: 'Faculty advisor supervising student welfare, research initiatives, and academic integrity across departments.',
    dossier: 'Faculty Directorate • College of Arts & Sciences',
    initials: 'JS',
  },
  {
    name: 'Dr. Cristina Dt. Geron',
    position: 'Head, Student Organizations',
    description: 'University authority presiding over institutional accreditation, organizational governance, and student compliance.',
    dossier: 'Office of Student Organizations • BatStateU',
    initials: 'CG',
  },
];

const studentSecretariat = [
  {
    name: 'Lian Beatrice S. Catipon',
    position: 'President, CAS Honor Society',
    description: 'Presiding over student scholar welfare, academic committees, and institutional assemblies.',
    email: 'cas.pb@g.batstate-u.edu.ph',
    initials: 'LC',
  },
  {
    name: 'Cristal B. Coliat',
    position: 'Secretary, CAS Honor Society',
    description: 'Directing secretariat archives, official certifications, and academic communications.',
    email: 'cas.pb@g.batstate-u.edu.ph',
    initials: 'CC',
  },
];

const committees = [
  {
    title: 'Academic Affairs & Colloquia',
    chair: 'Committee Directorate Chair',
    description: 'Orchestrates academic enrichment symposia, peer review workshops, and the flagship Veritas Research Colloquium in collaboration with CAS faculty.',
    activeProject: 'Veritas Forum 2025',
  },
  {
    title: 'Records & Honors Gazette',
    chair: 'Committee Directorate Chair',
    description: 'Audits True Copy of Grades (TCG) submissions, maintains the official Honor Roll registry, and certifies candidate lists for university honors convocations.',
    activeProject: 'Roll of Honor Audit',
  },
  {
    title: 'Scholar Welfare & Financial Aid',
    chair: 'Committee Directorate Chair',
    description: 'Administers the 100% dues waiver protocol for 4Ps and indigent scholars, coordinates study material grants, and organizes community outreach drives.',
    activeProject: 'Project Alab 2025',
  },
  {
    title: 'Public Relations & Creative Media',
    chair: 'Committee Directorate Chair',
    description: 'Directs visual branding, social media releases, Gazette publications, and student portal announcements adhering strictly to university media guidelines.',
    activeProject: "The Scholar's Ledger",
  },
];

const schedule = [
  {
    day: 'Monday',
    time: '9:00 AM – 12:00 PM',
    focus: "Dean's List TCG Verification",
    presiding: 'Committee on Records',
  },
  {
    day: 'Tuesday',
    time: '1:30 PM – 4:30 PM',
    focus: 'Financial Aid & Dues Waivers',
    presiding: 'Committee on Welfare',
  },
  {
    day: 'Wednesday',
    time: '10:00 AM – 3:00 PM',
    focus: 'Executive Inquiries & Endorsements',
    presiding: 'Lian Beatrice S. Catipon (President)',
  },
  {
    day: 'Thursday',
    time: '1:30 PM – 4:30 PM',
    focus: 'Certificate of Good Standing',
    presiding: 'Cristal B. Coliat (Secretary)',
  },
  {
    day: 'Friday',
    time: '2:00 PM – 5:00 PM',
    focus: 'Faculty Adviser Consultation',
    presiding: 'Dr. Jonelyn B. Sandoval (Faculty Adviser)',
  },
];
---

<BaseLayout
  title="Executive Officers & Directorate — CAS Honor Society"
  description="Meet our elected student executive secretariat, standing working committees, faculty advisers, and College Dean at BatStateU Pablo Borbon."
>
  <Navbar currentPath="/officers" />

  <SubpageHeader
    title="Executive Officers & Directorate"
    eyebrow="Leadership & Governance • A.Y. 2024–2025"
    description="Meet our elected student executive secretariat, standing working committees, faculty advisers, and College Dean."
    breadcrumbCurrent="Executive Officers"
    dossierCode="CAS-HS-DIR-2025"
    dossierLabel="LEADERSHIP ROSTER"
  />

  <main class="py-16 sm:py-20 container-gutter max-w-7xl mx-auto" id="officers">
    {/* ── Tier 1: Institutional Leadership & Faculty Directorate ── */}
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-12 pb-3 border-b border-border text-label font-ui font-bold uppercase tracking-wider text-gray-500">
        <span class="w-2 h-2 rounded-full bg-gold" aria-hidden="true"></span>
        <span>Institutional Supervision &amp; Advisory</span>
        <span class="text-stone-muted">•</span>
        <span class="font-mono text-label text-stone-muted font-normal">College of Arts and Sciences</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 text-center">
        {institutionalSupervisors.map((leader) => (
          <div class="group flex flex-col items-center">
            <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full mx-auto p-1 ring-2 ring-gold/40 group-hover:ring-maroon transition-all duration-120 ease-enter bg-surface shadow-card flex items-center justify-center mb-5">
              <div class="w-full h-full rounded-full bg-maroon-light flex items-center justify-center text-maroon font-heading text-h1 font-bold select-none">
                {leader.initials}
              </div>
            </div>
            <div>
              <h3 class="font-heading text-h2 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                {leader.name}
              </h3>
              <p class="text-body-sm font-ui font-bold text-maroon uppercase tracking-wider mt-1">
                {leader.position}
              </p>
              <p class="text-body-sm font-body text-gray-600 mt-2 max-w-xs mx-auto leading-relaxed">
                {leader.description}
              </p>
              <div class="mt-3 pt-2 text-label font-mono text-stone-muted">
                {leader.dossier}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ── Tier 2: Executive Student Secretariat ── */}
    <div class="pt-8 border-t border-border mb-20">
      <div class="flex items-center gap-3 mb-12 pb-3 border-b border-border text-label font-ui font-bold uppercase tracking-wider text-gray-500">
        <span class="w-2 h-2 rounded-full bg-maroon" aria-hidden="true"></span>
        <span>Executive Student Secretariat</span>
        <span class="text-stone-muted">•</span>
        <span class="font-mono text-label text-stone-muted font-normal">Elected Student Officers</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 lg:gap-20 max-w-3xl mx-auto text-center">
        {studentSecretariat.map((officer) => (
          <div class="group flex flex-col items-center">
            <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full mx-auto p-1 ring-2 ring-maroon/30 group-hover:ring-gold transition-all duration-120 ease-enter bg-surface shadow-card flex items-center justify-center mb-5">
              <div class="w-full h-full rounded-full bg-maroon-light flex items-center justify-center text-maroon font-heading text-h1 font-bold select-none">
                {officer.initials}
              </div>
            </div>
            <div>
              <h4 class="font-heading text-h2 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                {officer.name}
              </h4>
              <p class="text-body-sm font-ui font-bold text-maroon uppercase tracking-wider mt-1">
                {officer.position}
              </p>
              <p class="text-body-sm font-body text-gray-600 mt-2 max-w-xs mx-auto leading-relaxed">
                {officer.description}
              </p>
              <div class="mt-3">
                <a
                  href={`mailto:${officer.email}`}
                  class="text-label font-mono text-maroon hover:underline"
                >
                  {officer.email}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ── Standing Working Committees ── */}
    <div class="pt-10 border-t border-border mb-20" id="committees">
      <div class="mb-12 text-center max-w-3xl mx-auto space-y-2">
        <span class="text-label font-ui font-bold uppercase tracking-[0.2em] text-maroon block">
          Operational Structure
        </span>
        <h2 class="font-heading text-h1 text-gray-900 tracking-tight">
          Standing Working Committees
        </h2>
        <p class="font-body text-body-sm text-gray-600">
          Specialized bodies executing the society’s academic colloquia, honors verification, scholar welfare, and institutional communication.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {committees.map((comm) => (
          <div class="bg-surface border border-border rounded-card p-6 shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color] duration-120 ease-enter flex flex-col justify-between">
            <div class="space-y-2">
              <h3 class="font-heading text-h3 text-gray-900">
                {comm.title}
              </h3>
              <div>
                <span class="text-label font-ui font-semibold text-maroon">
                  {comm.chair}
                </span>
              </div>
              <p class="text-body-sm font-body text-gray-600 leading-relaxed pt-1">
                {comm.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-border/60 flex items-center justify-between text-label font-ui text-stone-muted">
              <span>Active Project:</span>
              <span class="font-bold text-maroon">{comm.activeProject}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ── Consultation Protocol & Office Hours ── */}
    <div class="pt-10 border-t border-border" id="consultation">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5 space-y-4">
          <span class="text-label font-ui font-bold uppercase tracking-[0.2em] text-maroon block">
            Secretariat Inquiries
          </span>
          <h2 class="font-heading text-h1 text-gray-900 tracking-tight leading-tight">
            Student Consultation &amp; Office Hours
          </h2>
          <p class="font-body text-body-sm text-gray-600 leading-relaxed">
            The Executive Secretariat welcomes all CAS scholars seeking grade evaluation clarifications, Certificate of Good Standing issuances, or membership inquiries.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3 p-4 bg-stone rounded-card border border-border">
              <div class="w-8 h-8 rounded-pill bg-surface border border-border flex items-center justify-center text-maroon shrink-0 text-body-sm shadow-xs font-bold">
                HQ
              </div>
              <div>
                <span class="font-bold text-body-sm text-gray-900 block font-ui">Physical Help Desk</span>
                <span class="text-body-sm text-gray-700 font-body">CAS Room 302, Pablo Borbon Main I Campus</span>
              </div>
            </div>

            <div class="flex items-start gap-3 p-4 bg-stone rounded-card border border-border">
              <div class="w-8 h-8 rounded-pill bg-surface border border-border flex items-center justify-center text-maroon shrink-0 text-body-sm shadow-xs font-bold">
                @
              </div>
              <div>
                <span class="font-bold text-body-sm text-gray-900 block font-ui">Official Inquiry Email</span>
                <a href="mailto:cas.pb@g.batstate-u.edu.ph" class="text-body-sm text-maroon hover:underline font-mono">
                  cas.pb@g.batstate-u.edu.ph
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 bg-surface border border-border rounded-card p-6 sm:p-8 shadow-card">
          <h3 class="font-heading text-h2 text-gray-900 mb-1">Secretariat Consultation Schedule</h3>
          <p class="text-label text-stone-muted font-body mb-6">Subject to faculty availability during examination weeks and academic recesses.</p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-body-sm border-collapse font-body">
              <thead>
                <tr class="border-b border-border text-stone-muted uppercase tracking-wider font-ui text-label bg-stone/50">
                  <th class="py-3 px-3">Day</th>
                  <th class="py-3 px-3">Consultation Window</th>
                  <th class="py-3 px-3">Focus Area</th>
                  <th class="py-3 px-3">Presiding Officer</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border text-gray-700">
                {schedule.map((row) => (
                  <tr class="hover:bg-stone/60 transition-colors duration-120 ease-enter">
                    <td class="py-3 px-3 font-semibold text-gray-900 font-ui">{row.day}</td>
                    <td class="py-3 px-3 font-medium text-maroon">{row.time}</td>
                    <td class="py-3 px-3">{row.focus}</td>
                    <td class="py-3 px-3 text-stone-muted">{row.presiding}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-6 pt-4 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 text-body-sm">
            <span class="text-stone-muted">Need immediate evaluation of your grades?</span>
            <a href="/deans-list#gwa-calc" class="font-ui font-bold text-maroon hover:text-maroon-hover flex items-center gap-1">
              <span>Use Online GWA Calculator</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <CrossPageBanner
        eyebrow="Academic Standards"
        heading="Check Dean's List Guidelines &amp; GWA Calculator"
        description="Review the official grade criteria, computation matrix, and application deadlines."
        buttonText="Dean's List Portal"
        buttonHref="/deans-list"
      />
    </div>
  </main>

  <Footer />
</BaseLayout>
