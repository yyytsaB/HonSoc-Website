  <Footer />

  <script>
    function setupTransparencyTabs() {
      const tabs = document.querySelectorAll('.tab-btn');
      const panels = {
        financial: document.getElementById('financial-panel'),
        resolutions: document.getElementById('resolutions-panel'),
        minutes: document.getElementById('minutes-panel'),
        accomplishments: document.getElementById('accomplishments-panel'),
        organizational: document.getElementById('organizational-panel')
      };

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target');
          if (!target) return;
          
          tabs.forEach(t => {
            t.className = 'tab-btn px-space-lg py-space-sm rounded-lg font-label-md text-label-md tracking-wider uppercase transition-all text-on-surface-variant hover:text-primary hover:bg-surface-container-highest';
          });
          tab.className = 'tab-btn px-space-lg py-space-sm rounded-lg font-label-md text-label-md tracking-wider uppercase transition-all bg-primary text-on-primary shadow-sm';

          Object.keys(panels).forEach(key => {
            const p = panels[key as keyof typeof panels];
            if (p) {
              if (key === target) {
                p.classList.remove('hidden');
              } else {
                p.classList.add('hidden');
              }
            }
          });
        });
      });

      const modal = document.getElementById('document-modal');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const modalDismiss = document.getElementById('modal-dismiss');
      const modalTitle = document.getElementById('modal-doc-title');
      const modalMeta = document.getElementById('modal-doc-meta');

      const docButtons = document.querySelectorAll('button[aria-label*="document"], button[aria-label*="clearance"], button[aria-label*="receipt"], button[aria-label*="report"]');
      docButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const row = btn.closest('tr');
          if (row && modalTitle && modalMeta) {
            const date = row.cells[0]?.innerText.trim() || '2026';
            const purpose = row.cells[1]?.querySelector('span')?.innerText.trim() || 'Disbursement Record';
            modalTitle.innerText = purpose + ' Official Voucher';
            modalMeta.innerText = 'Archived: ' + date + ' • Verified CAS Ledger Entry';
          }
          modal?.classList.remove('hidden');
        });
      });

      function closeModal() {
        modal?.classList.add('hidden');
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (modalDismiss) modalDismiss.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      const filterForm = document.getElementById('filter-form');
      if (filterForm) {
        filterForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const tbody = document.getElementById('financial-table-body');
          if (tbody) {
            tbody.style.opacity = '0.5';
            setTimeout(() => {
              tbody.style.opacity = '1';
            }, 250);
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTransparencyTabs);
    } else {
      setupTransparencyTabs();
    }
  </script>
</BaseLayout>
