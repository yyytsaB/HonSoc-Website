---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import SectionTabsIsland from '../components/navigation/SectionTabsIsland';
import Footer from '../components/navigation/Footer.astro';
import History from '../components/sections/History.astro';
import Gallery from '../components/sections/Gallery.astro';
import Membership from '../components/sections/Membership.astro';
import Officers from '../components/sections/Officers.astro';
import Accomplishments from '../components/sections/Accomplishments.astro';
import Merch from '../components/sections/Merch.astro';
import DlApplication from '../components/sections/DlApplication.astro';
import GwaCalculatorSection from '../components/sections/GwaCalculatorSection.astro';
import HallOfFame from '../components/sections/HallOfFame.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Card from '../components/primitives/Card.astro';
import Button from '../components/primitives/Button.astro';
import { getImage } from 'astro:assets';
import crestAsset from '../assets/crest.png';

const preloadedCrest = await getImage({
  src: crestAsset,
  width: 195,
  height: 145,
  format: 'avif',
  quality: 80,
});
---

<BaseLayout
  title="HonSoc — Honor Society | College of Arts and Sciences"
  description="The official website of the Honor Society. Access Dean's List applications, transparent semestral dues breakdown, officer directories, and academic accomplishments."
  preloadImage={preloadedCrest.src}
>
  {/* Sticky Frosted-Glass Navigation Bar */}
  <Navbar />

  <main id="main-content" class="min-h-screen">
    {/* Hero Section — Extends underneath the frosted navbar */}
    <Hero />

    {/* Section Switcher Island — Shadcn Tabs primitive with pill-toggle styling */}
    <section class="container-gutter py-8 bg-stone border-b border-border">
      <div class="max-w-5xl mx-auto text-center mb-4">
        <SectionHeading
          eyebrow="Quick Switcher"
          heading="Explore Society Sections"
          subheading="Direct access to chapter operations, student transparency reports, and honors registries."
          align="center"
        />
      </div>

      <SectionTabsIsland client:visible defaultTab="overview" />
    </section>

    {/* Milestone 3 Built Sections */}
    <History />
    <Gallery />
    <Membership />
    <Officers />
    <Accomplishments />

    {/* Milestone 4 Interactive Sections */}
    <Merch />
    <DlApplication />
    <GwaCalculatorSection />

    {/* Milestone 5 Section */}
    <HallOfFame />
  </main>

  {/* Footer with Logo */}
  <Footer />
</BaseLayout>
