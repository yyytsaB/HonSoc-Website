---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import { Image } from 'astro:assets';
import shieldImage from '../assets/cas-shield.png';
import heroBg from '../assets/hero-bg.jpg';
---

<BaseLayout title="CASHONSITE — A Public Database of CAS Honor Society">
  <Navbar currentPath="/" />

  <main class="w-full pt-[78px] bg-surface min-h-[calc(100vh-78px)] flex flex-col">
    <!-- 1. Hero Section with hero-bg.jpg and Gold-Yellow Linear Gradient -->
    <section aria-labelledby="heroHeading" class="relative w-full overflow-hidden pt-space-xl lg:pt-margin-lg pb-32 lg:pb-40 px-margin-sm lg:px-margin-lg bg-surface-container-low">
      <!-- Background Image with Gold-Yellow Linear Gradient Overlay -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <!-- hero-bg.jpg image with enhanced presence, anchored to the top to show the clock tower crown -->
        <img
          src={heroBg.src}
          alt=""
          role="presentation"
          class="w-full h-full object-cover object-top opacity-45 mix-blend-multiply filter contrast-105"
        />
        <!-- Linear gradient of gold-yellowish accenting the colors with clear architectural visibility -->
        <div class="absolute inset-0 bg-gradient-to-b from-secondary-fixed/40 via-surface-container-low/65 to-surface"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-secondary-fixed/25 via-transparent to-secondary-fixed-dim/20"></div>

        <!-- Ambient Gold & Crimson Glows -->
        <div class="absolute -top-32 right-1/4 w-96 h-96 rounded-full bg-secondary-container/25 blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/2 -left-28 w-80 h-80 rounded-full bg-primary-fixed/20 blur-3xl pointer-events-none"></div>
      </div>

      <!-- Hero Centerpiece: Text and Logo brought closer together with centered layout and balanced gap -->
      <div class="max-w-5xl xl:max-w-6xl mx-auto flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-8 xl:gap-10 relative z-10">
        <!-- Hero Content Column (Order 1 on desktop) -->
        <div class="w-full lg:max-w-lg xl:max-w-xl flex flex-col items-center text-center lg:items-start lg:text-left order-2 lg:order-1">
          <div class="flex items-center justify-center lg:justify-start gap-space-xs mb-space-xs">
            <span class="w-6 h-[2px] bg-secondary"></span>
            <span class="font-label-md text-[11px] sm:text-label-md uppercase tracking-widest text-secondary font-bold">
              Official Public Database
            </span>
            <span class="w-6 h-[2px] bg-secondary lg:hidden"></span>
          </div>

          <h1 id="heroHeading" class="font-headline-xl text-[40px] sm:text-[48px] lg:text-[56px] xl:text-[62px] text-primary font-normal tracking-tight uppercase leading-[0.98]">
            CASHONSITE
          </h1>

          <div class="font-serif text-[22px] sm:text-[28px] lg:text-[32px] xl:text-[36px] text-primary-container font-normal leading-tight mt-space-xs mb-space-sm">
            A Public Database of<br class="hidden sm:inline" /> CAS Honor Society
          </div>

          <p class="font-body-lg text-[16px] sm:text-[17px] xl:text-[18px] text-on-surface-variant max-w-lg mx-auto lg:mx-0 leading-relaxed mb-space-lg">
            A platform dedicated to transparency, accountability, and academic excellence. Explore our records, activities, and updates—all in one place.
          </p>

          <a
            href="/transparency"
            class="inline-flex items-center justify-center gap-space-xs px-space-lg py-3.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider font-semibold shadow-sm hover:bg-primary-container transition-all duration-150 transform hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>EXPLORE RECORDS</span>
            <span class="text-base leading-none">›</span>
          </a>
        </div>

        <!-- Hero Crest Image (Order 2 on desktop) — Sized in the ideal sweet spot -->
        <div class="relative w-full max-w-[280px] sm:max-w-[360px] md:max-w-[420px] lg:max-w-[480px] xl:max-w-[540px] flex items-center justify-center order-1 lg:order-2 shrink-0">
          <!-- Soft golden halo glow behind crest -->
          <div class="absolute w-[90%] h-[90%] rounded-full bg-secondary-fixed/50 blur-3xl pointer-events-none" aria-hidden="true"></div>

          <Image
            src={shieldImage}
            alt="CAS Honor Society Crest Banner and Shield"
            width={580}
            height={536}
            format="webp"
            quality={95}
            loading="eager"
            class="relative z-10 w-full h-auto object-contain drop-shadow-[0_20px_40px_rgba(106,2,10,0.3)] transition-transform duration-300 hover:scale-[1.02]"
          />
        </div>
      </div>
    </section>

    <!-- 2. Four Feature Cards (Overlapping Bottom of Hero) -->
    <section aria-label="Quick Access Services" class="relative z-20 max-w-7xl mx-auto px-margin-sm lg:px-margin-lg -mt-20 lg:-mt-24 mb-space-xl w-full">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md lg:gap-gutter">
        <!-- Card 1: Transparency Reports -->
        <a
          href="/transparency"
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-space-lg lg:py-space-xl lg:px-space-md flex flex-col items-center text-center shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-1 group cursor-pointer"
        >
          <div class="w-14 h-14 flex items-center justify-center text-primary mb-space-md group-hover:scale-110 transition-transform">
            <!-- Document with folded corner icon from mockup -->
            <svg class="w-11 h-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" x2="8" y1="13" y2="13"></line>
              <line x1="16" x2="8" y1="17" y2="17"></line>
              <line x1="10" x2="8" y1="9" y2="9"></line>
            </svg>
          </div>
          <h2 class="font-label-lg text-label-lg font-bold uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors mb-space-xs leading-snug">
            TRANSPARENCY<br />REPORTS
          </h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[230px] leading-relaxed">
            View financial reports, resolutions, minutes and other records.
          </p>
        </a>

        <!-- Card 2: Request A Document -->
        <a
          href="/request"
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-space-lg lg:py-space-xl lg:px-space-md flex flex-col items-center text-center shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-1 group cursor-pointer"
        >
          <div class="w-14 h-14 flex items-center justify-center text-primary mb-space-md group-hover:scale-110 transition-transform">
            <!-- Document with text lines icon from mockup -->
            <svg class="w-11 h-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="9" x2="15" y1="12" y2="12"></line>
              <line x1="9" x2="15" y1="16" y2="16"></line>
              <line x1="9" x2="10" y1="9" y2="9"></line>
            </svg>
          </div>
          <h2 class="font-label-lg text-label-lg font-bold uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors mb-space-xs leading-snug">
            REQUEST<br />A DOCUMENT
          </h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[230px] leading-relaxed">
            Need a certificate or official document? Submit a request.
          </p>
        </a>

        <!-- Card 3: Activities & Accomplishments -->
        <a
          href="/activities"
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-space-lg lg:py-space-xl lg:px-space-md flex flex-col items-center text-center shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-1 group cursor-pointer"
        >
          <div class="w-14 h-14 flex items-center justify-center text-primary mb-space-md group-hover:scale-110 transition-transform">
            <!-- Calendar with check marks icon from mockup -->
            <svg class="w-11 h-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
              <polyline points="9 14 11 16 15 12"></polyline>
            </svg>
          </div>
          <h2 class="font-label-lg text-label-lg font-bold uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors mb-space-xs leading-snug">
            ACTIVITIES &amp;<br />ACCOMPLISHMENTS
          </h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[230px] leading-relaxed">
            See our activities, projects, and accomplishment reports.
          </p>
        </a>

        <!-- Card 4: Give Feedback -->
        <a
          href="/feedback"
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-space-lg lg:py-space-xl lg:px-space-md flex flex-col items-center text-center shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-1 group cursor-pointer"
        >
          <div class="w-14 h-14 flex items-center justify-center text-primary mb-space-md group-hover:scale-110 transition-transform">
            <!-- Two speech bubbles icon from mockup -->
            <svg class="w-11 h-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              <path d="M14 9h.01"></path>
              <path d="M10 9h.01"></path>
              <path d="M6 9h.01"></path>
            </svg>
          </div>
          <h2 class="font-label-lg text-label-lg font-bold uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors mb-space-xs leading-snug">
            GIVE<br />FEEDBACK
          </h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[230px] leading-relaxed">
            We want to hear from you! Share your thoughts.
          </p>
        </a>
      </div>
    </section>

    <!-- 3. Commitment Band (Full Width, Consistent with other pages) -->
    <section aria-labelledby="commitmentHeading" class="w-full bg-primary text-on-primary py-space-xl border-t border-primary-container/40 mt-auto text-center">
      <div class="max-w-3xl mx-auto px-margin-sm lg:px-margin-lg flex flex-col items-center">
        <h2 id="commitmentHeading" class="font-headline-sm text-headline-sm text-surface-bright uppercase tracking-wider mb-space-sm font-normal">
          OUR COMMITMENT TO TRANSPARENCY
        </h2>
        <p class="font-body-md text-body-md text-surface-container-high/90 leading-relaxed max-w-2xl font-normal">
          CASHONSITE is built on the principle that organizational information should be accessible to the community it serves. Through the publication of our records and activities, we promote openness, accountability, and meaningful student engagement.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
