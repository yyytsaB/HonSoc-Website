---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/navigation/Footer.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import heroBgAsset from '../assets/hero-bg.webp';
import crestAsset from '../assets/crest.png';
import shieldAsset from '../assets/cas-shield.png';

const preloadedHero = await getImage({
  src: heroBgAsset,
  width: 1920,
  height: 1080,
  format: 'webp',
  quality: 85,
});

const accomplishments = await getCollection('accomplishments');
const leadershipSpotlight = [
  {
    name: 'Dr. Anna Maria V. Rivera',
    position: 'Dean & Chief Patron',
    role: 'College of Arts and Sciences',
    description: 'Ensuring academic rigor, university accreditation standards, and collegiate excellence.',
  },
  {
    name: 'Dr. Jonelyn B. Sandoval',
    position: 'Faculty Adviser',
    role: 'CAS Honor Society',
    description: 'Supervising student welfare, research initiatives, and academic integrity across departments.',
  },
  {
    name: 'Lian Beatrice S. Catipon',
    position: 'Society President',
    role: 'Student Executive Secretariat',
    description: 'Presiding over student scholar welfare, academic committees, and institutional assemblies.',
  },
];
---

<BaseLayout
  title="CAS Honor Society — Batangas State University Pablo Borbon"
  description="Official portal of the College of Arts and Sciences Honor Society, Batangas State University Pablo Borbon. Access Dean's List benchmarks, GWA matrix calculator, fee transparency, and leadership archives."
  preloadImage={preloadedHero.src}
>
  <Navbar currentPath="/" />

  <main id="main-content">
    {/* ── 1. Clocktower Hero Section ── */}
    <section class="relative min-h-[90vh] sm:min-h-[94vh] flex items-center justify-center pt-20 pb-16 px-4 overflow-hidden" id="hero">
      <div class="absolute inset-0 z-0">
        <Image
          src={heroBgAsset}
          alt="Batangas State University Pablo Borbon Clocktower"
          width={1920}
          height={1080}
          priority
          class="w-full h-full object-cover object-center filter brightness-90 contrast-[1.05]"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-maroon-wine/75 to-maroon-dark/98" aria-hidden="true"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center">
        {/* Dual Crests */}
        <div class="flex items-center justify-center gap-4 sm:gap-6 md:gap-8 mb-4">
          <Image
            src={crestAsset}
            alt="CAS Honor Society Crest Shield"
            width={180}
            height={134}
            class="h-24 sm:h-32 md:h-36 w-auto object-contain filter drop-shadow-[0_12px_24px_rgba(0,0,0,0.85)] hover:scale-105 transition-transform duration-120 ease-enter"
          />
          <Image
            src={shieldAsset}
            alt="CAS Official Shield Emblem"
            width={160}
            height={160}
            class="h-20 sm:h-28 md:h-32 w-auto object-contain filter drop-shadow-[0_12px_24px_rgba(234,168,56,0.4)] hover:scale-105 transition-transform duration-120 ease-enter"
          />
        </div>

        {/* Hero Typography */}
        <div class="space-y-3 sm:space-y-4 max-w-4xl px-3">
          <h1 class="font-heading text-display sm:text-6xl text-white font-normal leading-tight drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
            College of Arts and Sciences <br />
            <span class="text-gold font-heading drop-shadow-[0_2px_12px_rgba(234,168,56,0.4)]">Honor Society</span>
          </h1>
          <p class="font-ui text-sm sm:text-base md:text-lg font-semibold text-gold-lightGold max-w-2xl mx-auto tracking-wide drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
            Official Academic Society of the College of Arts and Sciences, Batangas State University Pablo Borbon.
          </p>
          <p class="font-body text-xs sm:text-sm text-stone-100 max-w-2xl mx-auto leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">
            Cultivating scholar-leaders devoted to academic excellence, social responsibility, and integrity.
          </p>
        </div>

        {/* Hero CTAs */}
        <div class="pt-5 sm:pt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/background"
            class="px-6 py-3 rounded-pill bg-shimmer text-maroon-dark font-ui text-body-sm font-bold shadow hover:shadow-card hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-[transform,box-shadow] duration-120 ease-enter uppercase tracking-wider flex items-center gap-2"
          >
            <span>Explore Society Charter</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/deans-list"
            class="px-6 py-3 rounded-pill bg-white/15 hover:bg-white/25 text-white border border-gold/40 font-ui text-body-sm font-semibold backdrop-blur-md transition-colors duration-120 ease-enter flex items-center gap-2"
          >
            <span>Dean's List &amp; GWA Calc</span>
            <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="4" y="2" width="16" height="20" rx="2"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="16" y1="14" x2="16" y2="18"></line>
              <path d="M16 10h.01"></path>
              <path d="M12 10h.01"></path>
              <path d="M8 10h.01"></path>
              <path d="M12 14h.01"></path>
              <path d="M8 14h.01"></path>
              <path d="M12 18h.01"></path>
              <path d="M8 18h.01"></path>
            </svg>
          </a>
        </div>

        {/* Institutional Quick Highlights */}
        <div class="mt-10 pt-5 border-t border-gold/25 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-label font-ui text-gold-lightGold font-medium">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Official CAS Accredited Society</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>A.Y. 2024–2025 Active Portal</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>Pablo Borbon Red Spartans</span>
          </div>
        </div>
      </div>
    </section>

    {/* ── 2. Portal Hub Modules ── */}
    <section class="py-16 sm:py-20 container-gutter max-w-7xl mx-auto border-b border-border" id="portal-hub">
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-2">
        <span class="text-label font-ui font-bold uppercase tracking-[0.2em] text-maroon block">
          Collegiate Platform
        </span>
        <h2 class="text-h1 font-heading text-gray-900 tracking-tight">
          CAS Honor Society Portal Modules
        </h2>
        <p class="text-body font-body text-gray-600">
          Access organizational archives, financial audits, leadership registries, merchandise, and academic computation utilities.
        </p>
      </div>

      <div class="space-y-6">
        {/* Primary Scholar Workbenches */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* Featured 1: GWA Calculator Matrix */}
          <div class="bg-gradient-to-br from-maroon-wine via-maroon-dark to-maroon text-white p-6 sm:p-8 rounded-card border-2 border-gold shadow-card flex flex-col justify-between relative overflow-hidden group">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-1.5 bg-shimmer text-maroon-dark text-label font-ui font-bold uppercase tracking-wider px-3 py-1 rounded-pill shadow-xs">
                  <span>Primary Scholar Tool</span>
                </span>
                <span class="text-label font-mono text-gold-lightGold">BatStateU Scale</span>
              </div>
              <h3 class="font-heading text-h2 text-white">Interactive GWA Matrix Calculator</h3>
              <p class="text-body-sm font-body text-gray-200 leading-relaxed">
                Simulate semestral grades, compute weighted averages matching official BatStateU grading policies, and evaluate qualification for Chancellor's and Dean's honors.
              </p>
              <div class="flex flex-wrap gap-2 text-label font-ui text-gold-lightGold pt-2">
                <span class="bg-white/10 px-2.5 py-1 rounded-pill border border-gold/30">1.00 – 1.45 First Honors</span>
                <span class="bg-white/10 px-2.5 py-1 rounded-pill border border-gold/30">1.46 – 1.75 Second Honors</span>
              </div>
            </div>
            <div class="mt-8 pt-5 border-t border-gold/30 flex items-center justify-between">
              <a
                href="/deans-list#gwa-calc"
                class="px-5 py-2.5 rounded-pill bg-shimmer text-maroon-dark font-ui text-body-sm font-bold shadow hover:shadow-card hover:-translate-y-0.5 active:translate-y-0 transition-[transform,box-shadow] duration-120 ease-enter inline-flex items-center gap-2"
              >
                <span>Launch Calculator</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <span class="text-label font-mono text-gold-lightGold hidden sm:inline">Instant Evaluation</span>
            </div>
          </div>

          {/* Featured 2: Dean's List Application */}
          <div class="bg-surface border-2 border-gold/60 p-6 sm:p-8 rounded-card shadow-card flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-1.5 bg-maroon text-white text-label font-ui font-bold uppercase tracking-wider px-3 py-1 rounded-pill shadow-xs">
                  <span>Official Application</span>
                </span>
                <span class="text-label font-ui font-semibold text-maroon">A.Y. 2024–2025</span>
              </div>
              <h3 class="font-heading text-h2 text-gray-900">Dean's List Verification &amp; Filing</h3>
              <p class="text-body-sm font-body text-gray-600 leading-relaxed">
                Complete official certification requirements, review documentary benchmarks, access the submission portal, and view scheduled validation deadlines across CAS departments.
              </p>
              <div class="flex flex-wrap gap-2 text-label font-ui text-gray-700 pt-2">
                <span class="bg-stone border border-border px-2.5 py-1 rounded-pill">15 Units Minimum</span>
                <span class="bg-stone border border-border px-2.5 py-1 rounded-pill">No Grade &lt; 2.00/2.50</span>
                <span class="bg-stone border border-border px-2.5 py-1 rounded-pill">Zero Incomplete</span>
              </div>
            </div>
            <div class="mt-8 pt-5 border-t border-border flex items-center justify-between">
              <a
                href="/deans-list#apply-dl"
                class="px-5 py-2.5 rounded-pill bg-maroon text-white hover:bg-maroon-hover font-ui text-body-sm font-bold shadow transition-colors duration-120 ease-enter inline-flex items-center gap-2"
              >
                <span>Apply for Dean's List</span>
                <svg class="w-3.5 h-3.5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a href="/deans-list" class="text-body-sm font-ui font-semibold text-maroon hover:underline">
                View Rubric &rarr;
              </a>
            </div>
          </div>
        </div>

        {/* Secondary 6-Module Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 pt-2">
          {/* Module 1 */}
          <a href="/background" class="group bg-stone hover:bg-surface border border-border hover:border-maroon/40 p-6 rounded-card shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color,background-color] duration-120 ease-enter flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-pill bg-maroon-light text-maroon flex items-center justify-center mb-4 group-hover:bg-maroon group-hover:text-white transition-colors duration-120 ease-enter">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                Organization Profile
              </h3>
              <p class="text-body-sm font-body text-gray-600 mt-2 leading-relaxed">
                Official institutional background, philosophy, vision, mission, strategic charter, and scholar roster.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/60 flex items-center text-body-sm font-ui font-semibold text-maroon gap-1.5">
              <span>View Background</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>

          {/* Module 2 */}
          <a href="/officers" class="group bg-stone hover:bg-surface border border-border hover:border-maroon/40 p-6 rounded-card shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color,background-color] duration-120 ease-enter flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-pill bg-maroon-light text-maroon flex items-center justify-center mb-4 group-hover:bg-maroon group-hover:text-white transition-colors duration-120 ease-enter">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                Executive Officers
              </h3>
              <p class="text-body-sm font-body text-gray-600 mt-2 leading-relaxed">
                Meet our student executive secretariat, standing working committees, faculty advisers, and College Dean.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/60 flex items-center text-body-sm font-ui font-semibold text-maroon gap-1.5">
              <span>Meet Leadership</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>

          {/* Module 3 */}
          <a href="/fees" class="group bg-stone hover:bg-surface border border-border hover:border-maroon/40 p-6 rounded-card shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color,background-color] duration-120 ease-enter flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-pill bg-maroon-light text-maroon flex items-center justify-center mb-4 group-hover:bg-maroon group-hover:text-white transition-colors duration-120 ease-enter">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                Membership &amp; Fees
              </h3>
              <p class="text-body-sm font-body text-gray-600 mt-2 leading-relaxed">
                Per-semester and full-year dues with complete transparent fund audits across student activities and welfare.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/60 flex items-center text-body-sm font-ui font-semibold text-maroon gap-1.5">
              <span>View Fee Details</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>

          {/* Module 4 */}
          <a href="#accomplishments" class="group bg-stone hover:bg-surface border border-border hover:border-maroon/40 p-6 rounded-card shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color,background-color] duration-120 ease-enter flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-pill bg-maroon-light text-maroon flex items-center justify-center mb-4 group-hover:bg-maroon group-hover:text-white transition-colors duration-120 ease-enter">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                Accomplishments
              </h3>
              <p class="text-body-sm font-body text-gray-600 mt-2 leading-relaxed">
                Community extension drives, annual research colloquiums, educational grants, and university projects.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/60 flex items-center text-body-sm font-ui font-semibold text-maroon gap-1.5">
              <span>Review Projects</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>

          {/* Module 5 */}
          <a href="/merch" class="group bg-stone hover:bg-surface border border-border hover:border-maroon/40 p-6 rounded-card shadow-xs hover:shadow-card-hover transition-[box-shadow,border-color,background-color] duration-120 ease-enter flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-pill bg-maroon-light text-maroon flex items-center justify-center mb-4 group-hover:bg-maroon group-hover:text-white transition-colors duration-120 ease-enter">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gray-900 group-hover:text-maroon transition-colors duration-120 ease-enter">
                Society Merch
              </h3>
              <p class="text-body-sm font-body text-gray-600 mt-2 leading-relaxed">
                Exclusive CAS varsity jackets, custom society lanyards, metal insignia pins, and order reservation portal.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/60 flex items-center text-body-sm font-ui font-semibold text-maroon gap-1.5">
              <span>Browse Catalog</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>

          {/* Module 6 */}
          <a href="/deans-list#honor-roll" class="group bg-maroon-wine text-white p-6 rounded-card shadow-card hover:shadow-card-hover transition-[box-shadow,border-color] duration-120 ease-enter flex flex-col justify-between border border-gold/40">
            <div>
              <div class="w-10 h-10 rounded-pill bg-shimmer text-maroon-dark flex items-center justify-center mb-4 shadow-xs">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              </div>
              <h3 class="font-heading text-h3 text-gold-lightGold">
                Roll of Honor
              </h3>
              <p class="text-body-sm font-body text-stone-100/90 mt-2 leading-relaxed">
                Celebrating BatStateU Pablo Borbon Dean's Listers, Latin Honors graduates, and academic distinction recipients.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-gold/30 flex items-center text-body-sm font-ui font-semibold text-gold-amber gap-1.5">
              <span>View Honorees</span>
              <span class="group-hover:translate-x-1 transition-transform duration-120 ease-enter">&rarr;</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    {/* ── 3. Society Overview & Philosophy Broadside Plaque ── */}
    <section class="py-16 sm:py-20 container-gutter max-w-7xl mx-auto border-b border-border">
      <div class="bg-gradient-to-br from-maroon-wine via-maroon-dark to-maroon text-white rounded-card p-8 sm:p-12 border border-gold/40 shadow-card relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <span class="text-label font-ui font-bold uppercase tracking-[0.2em] text-gold-lightGold block">
              Founding Philosophy
            </span>
            <h2 class="font-heading text-h1 text-white leading-tight">
              "In Scientia Veritas, In Virtute Prudentia"
            </h2>
            <p class="font-body text-body-sm text-stone-200 max-w-2xl leading-relaxed">
              In Knowledge, Truth; In Virtue, Wisdom. Established in 2020 at the College of Arts and Sciences, Batangas State University Pablo Borbon, the CAS Honor Society is the recognized autonomous governing body dedicated to evaluating, recognizing, and maintaining scholastic excellence.
            </p>
            <div class="pt-2 flex flex-wrap gap-4 text-label font-ui text-gold-lightGold">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
                <span>1,150+ Honor Scholars</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
                <span>Autonomous Student Body</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
                <span>Accredited Academic Organization</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col items-center lg:items-end justify-center gap-3">
            <a
              href="/background"
