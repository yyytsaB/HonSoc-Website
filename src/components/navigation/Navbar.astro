---
import Logo from './Logo.astro';
import MobileNavDrawer from './MobileNavDrawer';
import Button from '../primitives/Button.astro';

export interface Props {
  currentPath?: string;
  class?: string;
}

const {
  currentPath = Astro.url.pathname,
  class: className,
} = Astro.props;

// Normalize path by stripping trailing slash
const normalizedPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Background', href: '/background' },
  { label: 'Officers', href: '/officers' },
  { label: 'Dean’s List', href: '/deans-list' },
  { label: 'Fees', href: '/fees' },
  { label: 'Merchandise', href: '/merch' },
];
---

<header
  id="main-header"
  class:list={[
    'sticky top-0 z-40 w-full h-16 sm:h-20 box-border border-t-0 outline-none',
    // Frosted glass: semi-transparent surface with backdrop-blur — visually tested over hero image
    'bg-surface/90 backdrop-blur-md border-b border-border/80 shadow-sm transition-[background-color,border-color] duration-[120ms] ease-enter',
    className,
  ]}
>
  <div class="max-w-7xl mx-auto container-gutter h-full flex items-center justify-between gap-4">
    {/* Left: Brand Logo */}
    <div class="flex items-center">
      <Logo size="md" loading="eager" />
    </div>

    {/* Center: Desktop Navigation Links — whitespace-nowrap prevents line wrapping on all desktop widths */}
    <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 xl:gap-1.5 shrink-0">
      {navLinks.map((link) => {
        const isActive =
          normalizedPath === link.href ||
          (link.href !== '/' && normalizedPath.startsWith(link.href));

        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap px-3 py-1.5 rounded-pill text-[0.8125rem] xl:text-body-sm font-ui transition-[color,background-color,border-color] duration-[120ms] ease-enter focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold',
              isActive
                ? 'font-bold text-maroon bg-maroon-light/80 border border-maroon/20 shadow-xs'
                : 'font-semibold text-stone-text/80 hover:text-maroon hover:bg-maroon-light/50',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    {/* Right: Quick CTA & Mobile Drawer */}
    <div class="flex items-center gap-2.5">
      <div class="hidden xl:inline-flex">
        <a
          href="/deans-list#gwa-calc"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-pill text-[0.8125rem] font-ui font-semibold text-gray-700 hover:text-maroon hover:bg-stone transition-colors duration-120 ease-enter focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <svg class="w-3.5 h-3.5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="4" y="2" width="16" height="20" rx="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M16 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 14h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M8 18h.01"></path>
          </svg>
          <span>GWA Calc</span>
        </a>
      </div>

      <div class="hidden sm:inline-flex">
        <Button href="/deans-list#apply-dl" variant="primary" size="sm">
          Apply DL
        </Button>
      </div>

      {/* Mobile Nav Drawer Island — client:load per AGENTS.md §1 (above-the-fold nav toggle) */}
      <div class="lg:hidden">
        <MobileNavDrawer client:load items={navLinks} currentPath={normalizedPath} />
      </div>
    </div>
  </div>
</header>
