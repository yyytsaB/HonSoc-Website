---
import { Image } from 'astro:assets';
import shieldImage from '../../assets/cas-shield.png';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={['w-full bg-primary text-on-primary py-space-xl border-t border-primary-container/40 mt-auto', className]}>
  <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin-lg grid grid-cols-1 md:grid-cols-12 gap-gutter-lg">
    {/* Left Column: Brand & Manifesto */}
    <div class="md:col-span-5 flex flex-col gap-space-md">
      <div class="flex items-center gap-space-md">
        <Image
          src={shieldImage}
          alt="CAS Honor Society Crest"
          width={48}
          height={48}
          format="webp"
          quality={90}
          class="w-12 h-12 rounded-full object-contain p-1 border border-secondary-container bg-surface shadow-sm"
        />
        <div class="flex flex-col">
          <span class="font-headline-sm text-headline-sm text-surface-bright font-semibold leading-tight">
            CASHONSITE
          </span>
          <span class="font-label-xs text-label-xs text-secondary-fixed uppercase tracking-wider">
            A Public Database of CAS Honor Society
          </span>
        </div>
      </div>
      <p class="font-body-sm text-body-sm text-surface-container-high/80 max-w-sm leading-relaxed">
        An archival and public registry dedicated to scholarly distinction, research excellence, and institutional transparency across the College of Arts and Sciences.
      </p>
    </div>

    {/* Center Column: Quick Navigation Links */}
    <div class="md:col-span-3 flex flex-col gap-space-sm">
      <span class="font-label-md text-label-md text-secondary-fixed tracking-wider uppercase font-semibold">
        Quick Links
      </span>
      <ul class="flex flex-col gap-space-xs font-body-sm text-body-sm">
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/about">
            About the Society
          </a>
        </li>
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/transparency">
            Institutional Transparency
          </a>
        </li>
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/academic-recognition">
            Academic Recognition
          </a>
        </li>
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/activities">
            Convocations &amp; Activities
          </a>
        </li>
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/request">
            Document Verification Request
          </a>
        </li>
        <li class="flex">
          <a class="text-surface-container-high/90 hover:text-surface-bright transition-colors" href="/feedback">
            Feedback &amp; Inquiries
          </a>
        </li>
      </ul>
    </div>

    {/* Right Column: Institutional Contacts */}
    <div class="md:col-span-4 flex flex-col gap-space-sm">
      <span class="font-label-md text-label-md text-secondary-fixed tracking-wider uppercase font-semibold">
        Connect With Us
      </span>
      <div class="flex flex-col gap-space-xs font-body-sm text-body-sm text-surface-container-high/90">
        <div class="flex items-center gap-space-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary-fixed">mail</span>
          <span>cashonsite@cas.edu.ph</span>
        </div>
        <div class="flex items-start gap-space-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary-fixed mt-0.5">location_on</span>
          <span>CAS Building, College of Arts and Sciences</span>
        </div>
        <div class="flex items-center gap-space-xs mt-space-xs">
          <span class="material-symbols-outlined text-[18px] text-secondary-fixed">verified</span>
          <span>Official University Honor Guild Repository</span>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin-lg mt-space-lg pt-space-md border-t border-primary-container/60 flex flex-col sm:flex-row justify-between items-center gap-space-sm text-center sm:text-left">
    <span class="font-label-xs text-label-xs text-surface-container-high/60">
      © CAS Honor Society Database. Preserving Academic Excellence and Institutional Truth.
    </span>
    <span class="font-label-xs text-label-xs text-secondary-fixed/80 uppercase tracking-widest">
      Office of the Dean &amp; Academic Council
    </span>
  </div>
</footer>
