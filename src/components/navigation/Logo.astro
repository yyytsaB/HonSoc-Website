---
import { Image } from 'astro:assets';
import crestImage from '../../assets/crest.png';
import shieldImage from '../../assets/cas-shield.png';

export interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showSubtitle?: boolean;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  href = '/',
  size = 'md',
  showSubtitle = true,
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<a
  href={href}
  title="CAS Honor Society Homepage"
  class:list={[
    'group inline-flex items-center gap-2.5 sm:gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 rounded-xl pr-2 transition-all duration-120 ease-enter',
    className,
  ]}
>
  <div class="flex items-center gap-1.5 shrink-0">
    <Image
      src={shieldImage}
      alt="CAS Honor Society Shield"
      width={36}
      height={36}
      format="webp"
      quality={85}
      loading={loading}
      decoding="async"
      class="h-8 w-8 sm:h-9 sm:w-9 object-contain drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)] group-hover:scale-105 transition-transform duration-300"
    />
    <Image
      src={crestImage}
      alt="CAS Floral Lotus Emblem"
      width={32}
      height={24}
      format="webp"
      quality={85}
      loading={loading}
      decoding="async"
      class="h-7 w-7 sm:h-8 sm:w-8 object-contain drop-shadow-[0_2px_8px_rgba(212,175,55,0.6)] group-hover:scale-105 transition-transform duration-300"
    />
  </div>

  <div class="text-left flex flex-col justify-center">
    <span class="font-heading text-xs sm:text-sm lg:text-base font-bold tracking-wider text-gray-900 group-hover:text-maroon uppercase transition-colors leading-tight">
      CAS HONOR SOCIETY
    </span>
    {showSubtitle && (
      <span class="text-[9px] sm:text-[10px] uppercase tracking-widest text-gold-accessible font-medium -mt-0.5 hidden sm:block">
        BatStateU • Pablo Borbon
      </span>
    )}
  </div>
</a>
