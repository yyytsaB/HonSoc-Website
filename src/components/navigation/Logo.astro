---
import { Image } from 'astro:assets';
import crestImage from '../../assets/crest.png';

export interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showSubtitle?: boolean;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  href = '/',
  size = 'md',
  showSubtitle = true,
  class: className,
  loading = 'lazy',
} = Astro.props;

// Explicit pixel dimensions preserving exact 1704:1264 aspect ratio (1.348:1)
const dimensions = {
  sm: { width: 43, height: 32 },
  md: { width: 54, height: 40 },
  lg: { width: 70, height: 52 },
  xl: { width: 108, height: 80 },
};

const textSizes = {
  sm: 'text-h3',
  md: 'text-h2',
  lg: 'text-h1',
  xl: 'text-display',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 rounded-pill pr-2',
    className,
  ]}
>
  <div class="relative shrink-0 flex items-center justify-center">
    <Image
      src={crestImage}
      alt="HonSoc Official Crest"
      width={dimensions[size].width}
      height={dimensions[size].height}
      format="webp"
      quality={80}
      loading={loading}
      decoding="async"
      class="object-contain transition-transform duration-[120ms] ease-enter group-hover:scale-105"
    />
  </div>

  <div class="flex flex-col text-left leading-tight">
    <span class:list={['font-heading font-semibold text-gray-900 group-hover:text-maroon transition-colors duration-[120ms] ease-enter', textSizes[size]]}>
      HonSoc
    </span>
    {showSubtitle && (
      <span class="text-label font-ui font-semibold text-gold-accessible uppercase tracking-wider">
        Honor Society
      </span>
    )}
  </div>
</a>
