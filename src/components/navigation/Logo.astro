---
import { Image } from 'astro:assets';
import shieldImage from '../../assets/cas-shield.png';

export interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showSubtitle?: boolean;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  href = '/',
  showSubtitle = true,
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<a
  href={href}
  title="CAS Honor Society Homepage"
  class:list={[
    'flex items-center gap-2 sm:gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg transition-colors shrink-0',
    className,
  ]}
>
  <Image
    src={shieldImage}
    alt="CAS Honor Society Crest"
    width={56}
    height={56}
    format="webp"
    quality={95}
    loading={loading}
    decoding="async"
    class="w-12 h-12 sm:w-[52px] sm:h-[52px] rounded-full object-contain p-1 bg-surface-container-lowest border border-secondary/40 shadow-xs shrink-0 group-hover:border-secondary group-hover:scale-105 transition-all duration-200"
  />

  <div class="flex flex-col justify-center">
    <span class="font-headline-sm text-[21px] sm:text-headline-sm font-bold tracking-tight text-primary leading-none group-hover:text-primary-container transition-colors">
      CASHONSITE
    </span>
    {showSubtitle && (
      <span class="font-label-xs text-[9.5px] sm:text-[10.5px] tracking-wider text-on-surface-variant uppercase mt-1 leading-none font-medium">
        A Public Database of CAS Honor Society
      </span>
    )}
  </div>
</a>
