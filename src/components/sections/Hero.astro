---
import { Image } from "astro:assets";
import crestImage from "../../assets/crest.png";
import casShieldImage from "../../assets/cas-shield.png";
import HeroBackdrop from "./HeroBackdrop.astro";
import Button from "../primitives/Button.astro";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  id="hero"
  class:list={[
    "relative overflow-hidden -mt-16 sm:-mt-20 pt-16 sm:pt-20 min-h-[100dvh] w-full flex flex-col justify-center items-center",
    className,
  ]}
>
  {
    /* Atmospheric backdrop: Full-bleed red gradient layered over Pablo Borbon campus landmark */
  }
  <HeroBackdrop />

  {/* Vertically centered unified content block */}
  <div
    class="max-w-5xl mx-auto container-gutter relative z-10 flex flex-col items-center text-center py-6 sm:py-8"
  >
    {
      /* Dual Emblem Focal Center — CAS Shield and Crescent Lotus Crest side-by-side */
    }
    <div
      class="mb-2 sm:mb-3 flex flex-row items-center justify-center gap-2 sm:gap-4 md:gap-6 px-4 shrink-0"
    >
      {/* CAS Honor Society Shield Emblem */}
      <Image
        src={casShieldImage}
        alt="College of Arts and Sciences Honor Society Shield"
        width={420}
        height={420}
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: clamp(160px, 28vw, 420px); height: auto;"
        class="relative z-10 object-contain filter drop-shadow-[0_16px_36px_rgba(0,0,0,0.95)] hover:scale-105 transition-transform duration-300"
      />

      {/* Crescent Lotus Crest Emblem */}
      <Image
        src={crestImage}
        alt="College of Arts and Sciences Honor Society Crescent Crest"
        width={368}
        height={273}
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: clamp(140px, 24.5vw, 368px); height: auto;"
        class="relative z-10 object-contain filter drop-shadow-[0_16px_36px_rgba(212,175,55,0.6)] hover:scale-105 transition-transform duration-300"
      />
    </div>

    {
      /* Heading: College of Arts and Sciences / Honor Society (gradiented left -> light gold to right -> darker shade) */
    }
    <h1
      class="font-heading text-h1 sm:text-[2.6rem] md:text-[3.25rem] text-white tracking-tight leading-[1.14] drop-shadow-md max-w-4xl"
    >
      <span class="block">College of Arts and Sciences</span>
      <span
        class="block mt-1 sm:mt-2 text-transparent bg-clip-text bg-gradient-to-r from-[#FDF0C8] via-[#EAA838] to-[#945C04] drop-shadow-[0_2px_14px_rgba(234,168,56,0.30)]"
      >
        Honor Society
      </span>
    </h1>

    {
      /* Subheading: The premier academic organization of the College of Arts and Sciences at Pablo Borbon Campus */
    }
    <p
      class="mt-4 sm:mt-5 font-ui text-body sm:text-body-lg text-white/90 max-w-2xl leading-relaxed drop-shadow-sm"
    >
      The premier academic organization of the College of Arts and Sciences at
      Pablo Borbon Campus. Cultivating scholar-leaders devoted to academic
      excellence, social responsibility, and integrity.
    </p>

    {/* Single Primary Call-to-Action — High-contrast white pill button */}
    <div class="mt-7 sm:mt-8 flex items-center justify-center w-full sm:w-auto">
      <Button
        href="#dl-application"
        variant="inverted"
        size="lg"
        class="w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98]"
      >
        Apply for Dean's List
      </Button>
    </div>
  </div>
</section>
