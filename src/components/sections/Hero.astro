---
import { Image } from 'astro:assets';
import crestImage from '../../assets/crest.png';
import HeroBackdrop from './HeroBackdrop.astro';
import Button from '../primitives/Button.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  id="hero"
  class:list={[
    'relative overflow-hidden -mt-16 sm:-mt-20 pt-28 sm:pt-36 md:pt-40 pb-16 sm:pb-24 md:pb-28 border-b border-border',
    className,
  ]}
>
  {/* Isolated atmospheric backdrop layer — swappable without modifying Hero layout */}
  <HeroBackdrop />

  <div class="max-w-4xl mx-auto container-gutter relative z-10 flex flex-col items-center text-center">
    {/* Dominant Crest Anchor — Optically tuned across viewports to lead the visual hierarchy */}
    <div class="mb-6 sm:mb-8 md:mb-10 flex items-center justify-center shrink-0">
      <div class="relative filter-none sm:drop-shadow-[0_8px_24px_rgba(139,30,30,0.12)]">
        <Image
          src={crestImage}
          alt="College of Arts and Sciences Honor Society Crest"
          width={195}
          height={145}
          format="avif"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-[114px] h-[85px] sm:w-[155px] sm:h-[115px] md:w-[195px] md:h-[145px] object-contain transition-transform duration-300 ease-enter hover:scale-[1.02]"
        />
      </div>
    </div>

    {/* Single H1 Headline: font-heading (Alice), size text-display, bold & focused */}
    <h1 class="font-heading text-display text-stone-text tracking-tight max-w-3xl leading-[1.12]">
      Academic Distinction. Genuine Service.
    </h1>

    {/* Single-sentence Subtitle: font-ui, text-body-lg, quiet weight in warm stone-muted */}
    <p class="mt-4 sm:mt-5 md:mt-6 font-ui text-body-lg text-stone-muted max-w-xl leading-relaxed">
      The official student honor society of the College of Arts and Sciences, dedicated to scholarship, integrity, and student leadership.
    </p>

    {/* Single Primary Call-to-Action — Singular focus replacing competing actions */}
    <div class="mt-8 sm:mt-9 md:mt-10 flex items-center justify-center w-full sm:w-auto">
      <Button
        href="#dl-application"
        variant="primary"
        size="lg"
        class="w-full sm:w-auto shadow-sm hover:shadow-md transition-shadow duration-120"
      >
        Apply for Dean's List
      </Button>
    </div>
  </div>
</section>
