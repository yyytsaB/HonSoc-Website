---
import { getCollection } from 'astro:content';
import SectionHeading from '../primitives/SectionHeading.astro';
import Card from '../primitives/Card.astro';
import Pill from '../primitives/Pill.astro';
import { MerchModal } from '../interactive/MerchModal';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const merchItems = await getCollection('merch');
---

<section id="merch" class:list={['section-padding container-gutter scroll-mt-20', className]}>
  <div class="max-w-5xl mx-auto">
    <SectionHeading
      eyebrow="Society Apparel"
      heading="Official Merchandise"
      subheading="Chapter fleece jackets, polo shirts, and commemorative accessories for HonSoc members."
    />

    {/* Section-level Disclaimer Banner */}
    <div
      role="status"
      class="mt-6 flex items-start gap-3 rounded-card border border-amber-200 bg-amber-50/80 p-4 text-amber-900 text-body-sm"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5 text-amber-600 flex-shrink-0 mt-0.5"
        aria-hidden="true"
      >
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
      <div>
        <span class="font-ui font-semibold block uppercase tracking-wider text-label text-amber-900">
          Provisional Merchandise Catalog Notice
        </span>
        <p class="mt-0.5 text-amber-800">
          All catalog items and pricing represent preliminary design mockups undergoing committee review. Official pricing and pre-order batches will activate upon Executive Committee authorization.
        </p>
      </div>
    </div>

    {/* Merchandise Grid */}
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {merchItems.map((item) => (
        <Card as="article" variant="hover" class="flex flex-col h-full overflow-hidden">
          {/* Mockup Preview */}
          <div class="relative w-full aspect-[4/3] bg-stone-100 border-b border-border overflow-hidden">
            <img
              src={item.data.images[0] || '/images/merch-placeholder.svg'}
              alt={item.data.name}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
            <div class="absolute top-3 right-3">
              <Pill variant="gold" size="sm">Draft Mockup</Pill>
            </div>
          </div>

          <div class="p-6 flex flex-col flex-grow">
            <div class="flex-grow">
              <h3 class="text-h3 font-heading text-maroon leading-snug">
                {item.data.name}
              </h3>
              
              {item.data.description && (
                <p class="text-body-sm text-stone-muted mt-2 line-clamp-2">
                  {item.data.description}
                </p>
              )}

              {/* Swatch & Size Highlights */}
              <div class="mt-4 pt-3 border-t border-border flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5" aria-label="Available colors">
                  {item.data.colors.map((c) => (
                    <span
                      title={c.label}
                      class="h-4 w-4 rounded-full border border-black/20"
                      style={{ backgroundColor: c.hex }}
                    />
                  ))}
                  <span class="text-label text-stone-muted ml-1">{item.data.colors.length} colors</span>
                </div>

                <div class="text-label text-stone-muted font-ui">
                  Sizes: {item.data.sizes.join(', ')}
                </div>
              </div>
            </div>

            {/* Price & Action */}
            <div class="mt-6 pt-4 border-t border-border flex items-center justify-between gap-4">
              <div>
                <span className="text-label text-stone-muted uppercase block">Estimated Target</span>
                <span class="text-body-lg font-ui font-bold text-gray-900">
                  ₱{item.data.price}
                </span>
              </div>

              <MerchModal client:visible item={item.data} triggerText="Pre-order Details" />
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
