---
export interface Props {
  title: string;
  eyebrow: string;
  description: string;
  breadcrumbCurrent: string;
  dossierCode?: string;
  dossierLabel?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  description,
  breadcrumbCurrent,
  dossierCode = 'DOC: CAS-HS-PB-2025',
  dossierLabel = 'COLLEGIATE ARCHIVE',
  class: className = '',
} = Astro.props;
---

<header class:list={['relative overflow-hidden bg-gradient-to-r from-maroon-dark via-maroon-wine to-maroon text-white border-b border-gold/30 pt-10 pb-12 sm:pt-14 sm:pb-16', className]}>
  {/* Ambient decorative elements */}
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto container-gutter relative z-10">
    {/* Breadcrumbs & Dossier Code */}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6 text-body-sm font-ui">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-white/70">
        <a href="/" class="hover:text-gold transition-colors duration-120 ease-enter">Home</a>
        <span class="text-white/40" aria-hidden="true">/</span>
        <span class="text-white font-medium" aria-current="page">{breadcrumbCurrent}</span>
      </nav>

      {dossierCode && (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-pill bg-black/25 border border-gold/30 text-label font-mono text-gold-lightGold">
          <span class="w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
          <span>{dossierCode}</span>
          {dossierLabel && <span class="text-white/50">· {dossierLabel}</span>}
        </div>
      )}
    </div>

    {/* Content */}
    <div class="max-w-4xl space-y-3">
      <div class="inline-block">
        <span class="text-label font-ui font-bold uppercase tracking-[0.2em] text-gold-amber block">
          {eyebrow}
        </span>
      </div>
      <h1 class="text-display font-heading font-normal text-white tracking-tight leading-tight">
        {title}
      </h1>
      <p class="text-body font-body text-white/85 max-w-3xl leading-relaxed pt-1">
        {description}
      </p>
    </div>
  </div>
</header>
