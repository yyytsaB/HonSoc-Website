---
import { Image } from 'astro:assets';
import heroBg from '../../assets/bsu.jpg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/*
  HeroBackdrop.astro
  Full-bleed dramatic, saturated collegiate maroon backdrop combined with the
  landmark Pablo Borbon campus clock tower architecture.
*/}
<div class:list={['absolute inset-0 -z-10 select-none pointer-events-none overflow-hidden', className]} aria-hidden="true">
  {/* Campus landmark building photograph layer */}
  <Image
    src={heroBg}
    alt="Batangas State University Pablo Borbon Campus Clocktower"
    class="absolute inset-0 w-full h-full object-cover object-center filter brightness-90 contrast-[1.05]"
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
  />

  {/* Deep Crimson Gradient Overlay matching Design/index.html */}
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(0, 0, 0, 0.2) 0%, rgba(160, 25, 30, 0.65) 42%, rgba(42, 4, 6, 0.98) 100%);"
  />
</div>
