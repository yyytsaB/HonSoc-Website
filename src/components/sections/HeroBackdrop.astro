---
import { Image } from 'astro:assets';
import heroBg from '../../assets/hero-bg.jpg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/*
  HeroBackdrop.astro
  Full-bleed dramatic, saturated collegiate maroon backdrop combined with the
  landmark Pablo Borbon campus clock tower architecture.
  Single continuous pure CSS radial gradient layered over architectural photography.
*/}
<div class:list={['absolute inset-0 -z-10 select-none pointer-events-none overflow-hidden', className]} aria-hidden="true">
  {/* Campus landmark building photograph layer */}
  <Image
    src={heroBg}
    alt=""
    class="absolute inset-0 w-full h-full object-cover object-[center_35%] opacity-22 mix-blend-luminosity filter contrast-125"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
  />

  {/* Saturated collegiate maroon radial gradient radiating outward from behind the dual logos */}
  <div
    class="absolute inset-0 w-full h-full"
    style="background: radial-gradient(ellipse 140% 105% at 50% 36%, rgba(247, 214, 142, 0.40) 0%, rgba(240, 192, 102, 0.32) 7%, rgba(226, 154, 62, 0.28) 14%, rgba(206, 88, 48, 0.42) 23%, rgba(175, 42, 42, 0.65) 34%, rgba(139, 30, 30, 0.88) 46%, rgba(122, 25, 25, 0.94) 56%, #661414 66%, #520F0F 76%, #3E0B0B 86%, #280606 100%);"
  />

  {/* Vignette depth layer ensuring high contrast and pristine readability */}
  <div class="absolute inset-0 bg-[#280606]/35" />
</div>
